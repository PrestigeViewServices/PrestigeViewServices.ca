# =============================================================================
# Prestige View Services — environment variables
# =============================================================================
#
# 1. COPY THIS FILE to .env.local in the same folder (the .local file is
#    ignored by git so your real secrets never get committed).
# 2. Fill in the values below. Every line has a comment explaining what it is
#    and EXACTLY where to get it.
# 3. Run `npm run setup:check` to confirm everything is wired up before
#    starting the app.
#
# For the LIVE site, the same variables go in Vercel:
#   Project → Settings → Environment Variables → then Deployments → Redeploy.
#
# The three REQUIRED values for the admin dashboard are marked (REQUIRED).
# Everything else can wait. Full step-by-step lives in SETUP.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Admin dashboard sign-in  (REQUIRED)  —  no external auth service
# -----------------------------------------------------------------------------
# /admin is protected by an in-house login. Sign in with ADMIN_EMAIL +
# ADMIN_PASSWORD. This pair is the RECOVERY LOGIN: it always works, even if a
# saved password is forgotten or the database is unreachable, so keep both
# set on Vercel. Rotate ADMIN_PASSWORD to revoke it.
#
# More admins (each with their own email + password) are added from the
# dashboard at /admin/account, or from a terminal: `npm run admin add you@x.com`.
ADMIN_EMAIL=you@prestigeviewservices.ca
ADMIN_PASSWORD=change-me-to-at-least-10-characters

# Signs the admin session cookie (falls back to ADMIN_PASSWORD if unset).
# Set a long random string on Vercel; rotating it signs every device out.
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=


# -----------------------------------------------------------------------------
# Database (Postgres)  (REQUIRED)  —  every dashboard page reads from it
# -----------------------------------------------------------------------------
# Where to get this:
#   OPTION A — Neon (recommended, free, takes ~2 min):
#     1. Sign up at https://console.neon.tech
#     2. Create a new project (pick the region closest to you)
#     3. On the dashboard click "Connect"
#     4. Copy the full connection string under "Connection string"
#        (make sure "Pooled connection" is OFF — migrations need a direct link)
#   OPTION B — Supabase:
#     1. Sign up at https://supabase.com
#     2. Create a new project
#     3. Project Settings → Database → Connection string → URI
#
# It must start with `postgresql://` or `postgres://` and end with `?sslmode=require`.
# Pending migrations are applied automatically on every Vercel deploy
# (scripts/vercel-build.mjs). Locally: `npm run db:deploy`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# The public URL of your site. Used for sitemap, Open Graph, and SEO.
# In dev, leave it as the production URL — Next.js handles the localhost rewrite.
NEXT_PUBLIC_SITE_URL=https://prestigeviewservices.ca

# Business phone in E.164 format. Powers the click-to-call button.
NEXT_PUBLIC_BUSINESS_PHONE=+1-613-334-5858


# -----------------------------------------------------------------------------
# OWNER INTAKE NOTIFICATIONS  (lib/notify.ts)  —  strongly recommended
# -----------------------------------------------------------------------------
# Every website intake (quote requests, winter reservations, job applications,
# support tickets, new club members, claimed accounts, giveaway entries) fans
# out to the owner here. Submissions ALWAYS save to Postgres first, so nothing
# is ever lost when these are unset — they just don't reach an inbox.
# The Command Center shows a warning banner while either channel is off.
#
# EMAIL — nothing sends without it. Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=
# Verified sender, e.g. "PVS Website <notifications@prestigeviewservices.ca>".
# Verify the domain in Resend first; the shared onboarding@resend.dev sender
# only delivers to the Resend account owner.
LEAD_FROM_EMAIL=
# Who receives them. COMMA-SEPARATED list for multiple inboxes.
OWNER_NOTIFY_EMAIL=
#
# SMS — optional. Either Twilio (preferred) …
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# … or a carrier email-to-text gateway, which reuses RESEND_API_KEY.
# Telus: 6137626009@msg.telus.com · Bell: @txt.bell.ca · Rogers: @pcs.rogers.com
OWNER_SMS_GATEWAY=
# Destination for Twilio SMS, E.164 format.
OWNER_NOTIFY_PHONE=

# Separate inboxes per channel (optional, default to contact@).
APPLICATION_NOTIFICATION_EMAIL=hiring@prestigeviewservices.ca
SUPPORT_NOTIFICATION_EMAIL=support@prestigeviewservices.ca


# -----------------------------------------------------------------------------
# Cloudinary (image host)  —  needed for /admin/site/photos uploads
# -----------------------------------------------------------------------------
# Where to get these:
#   1. Sign up at https://cloudinary.com (the free tier is plenty)
#   2. Click the gear icon → Settings → API Keys
#   3. Copy the three values below
# Your cloud name appears in the dashboard URL: cloudinary.com/console/cloud_name/...
# Uploaded photos land in pvs/gallery/<section> for organization.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# Analytics & search (optional)
# -----------------------------------------------------------------------------
# Vercel Analytics auto-enables when deployed to Vercel — no key needed.
# Google Analytics 4 measurement ID: Admin → Data Streams → Web → `G-XXXXXXX`
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console → Settings → Ownership → HTML tag (content value only)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Settings → Site Owner Verification → Meta tag
BING_SITE_VERIFICATION=


# -----------------------------------------------------------------------------
# The Prestige Club (customer portal + loyalty)
# -----------------------------------------------------------------------------
# Signs member session cookies (falls back to ADMIN_SESSION_SECRET). Set a
# long random value on Vercel too.
CUSTOMER_SESSION_SECRET=
# Jobber GraphQL access token (Phase 1 read-only sync). Leave empty until the
# Jobber app is created — the sync is a clean no-op without it.
JOBBER_ACCESS_TOKEN=
# Protects /api/cron/jobber-sync. Vercel sends it automatically when set.
CRON_SECRET=
# Where new portal requests are emailed (defaults to contact@).
CLUB_NOTIFY_EMAIL=
# From address for club emails (defaults to LEAD_FROM_EMAIL).
CLUB_FROM_EMAIL=
# Guard for future Jobber write operations (invoice credit automation).
# Leave unset/false to keep the integration strictly read-only.
JOBBER_ALLOW_WRITES=
# Jobber OAuth app (Developer Center). With these set, admins connect via
# the "Connect Jobber" button; tokens auto-refresh in the database.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
